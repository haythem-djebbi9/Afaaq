# Copy to .env and fill in real values. Never commit .env — see .gitignore.

# Backend API base URL, including the /api prefix.
# Local dev (non-docker): http://localhost:3000/api
# Docker Compose: /api (nginx proxies it to the backend container)
# Production (Vercel): https://your-backend.onrender.com/api
VITE_API_URL=http://localhost:3000/api
