# Single source of truth for every environment variable used by AFAAQ CONNECT
# (frontend + backend + docker-compose). Copy to .env and fill in real values.
# Never commit .env — see .gitignore.
#
#   docker compose up --build   # reads this file automatically
#
# For non-docker local dev, copy the matching values into backend/.env and
# frontend/.env instead (Vite and Nest each read their own app-local .env file).

# ---- PostgreSQL (used by the `postgres` container and to build the backend's DATABASE_URL) ----
POSTGRES_USER=afaaq
POSTGRES_PASSWORD=change-me
POSTGRES_DB=afaaq

# ---- Backend (NestJS) ----
# Non-docker local dev only: backend/.env needs a full DATABASE_URL, e.g.
# postgresql://afaaq:change-me@127.0.0.1:5432/afaaq?schema=public
JWT_SECRET=change-me
JWT_EXPIRES_IN=7d
CORS_ORIGIN=http://localhost:5173,http://localhost:8080
LOG_LEVEL=log

# Groq API key for the chatbot and auto-translation (chat completions).
# Backend-only — never expose to the frontend. Get one at https://console.groq.com/keys
GROQ_API_KEY=gsk_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
GROQ_MODEL=llama-3.3-70b-versatile

# ---- Frontend (Vite) ----
# Docker: leave as /api — nginx proxies it to the backend container.
# Non-docker local dev (frontend/.env): use http://localhost:3000/api
VITE_API_URL=/api

# ---- docker-compose host port mapping ----
BACKEND_PORT=3000
FRONTEND_PORT=8080
