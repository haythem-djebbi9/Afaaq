# Single source of truth for every environment variable used by AFAAQ CONNECT
# (frontend + backend + docker-compose). Copy to .env and fill in real values.
# Never commit .env — see .gitignore.
#
#   docker compose up --build   # reads this file automatically
#
# For non-docker local dev, copy the matching values into backend/.env and
# frontend/.env instead (Vite and Nest each read their own app-local .env file).

# ---- PostgreSQL (used by the `postgres` container and to build the backend's DATABASE_URL) ----
POSTGRES_USER=afaaq
POSTGRES_PASSWORD=change-me
POSTGRES_DB=afaaq

# ---- Backend (NestJS) ----
# Non-docker local dev only: backend/.env needs a full DATABASE_URL, e.g.
# postgresql://afaaq:change-me@127.0.0.1:5432/afaaq?schema=public
JWT_SECRET=change-me
JWT_EXPIRES_IN=7d
CORS_ORIGIN=http://localhost:5173,http://localhost:8080
LOG_LEVEL=log

# Groq API key for the chatbot and auto-translation (chat completions).
# Backend-only — never expose to the frontend. Get one at https://console.groq.com/keys
GROQ_API_KEY=gsk_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
GROQ_MODEL=llama-3.3-70b-versatile

# Stripe — one-time "frais de dossier" payment, required after step 7 of the wizard
# before an application can be submitted. Backend-only.
# Secret key (test or live) — https://dashboard.stripe.com/test/apikeys
STRIPE_SECRET_KEY=REPLACE_WITH_YOUR_STRIPE_TEST_SECRET_KEY
# Webhook signing secret, to verify events genuinely come from Stripe — created when you
# add the endpoint at https://dashboard.stripe.com/test/webhooks (URL: <APP_URL>/api/payments/webhook).
# For local testing: `stripe listen --forward-to localhost:3000/api/payments/webhook` prints one.
STRIPE_WEBHOOK_SECRET=REPLACE_WITH_YOUR_STRIPE_WEBHOOK_SIGNING_SECRET
# Fee amount in cents (2000 = 20,00 €).
STRIPE_APPLICATION_FEE_CENTS=2000
# Public frontend URL, used to build the Stripe Checkout success/cancel redirect.
# Docker: http://localhost:8080. Non-docker local dev: http://localhost:5173.
APP_URL=http://localhost:8080

# ---- Frontend (Vite) ----
# Docker: leave as /api — nginx proxies it to the backend container.
# Non-docker local dev (frontend/.env): use http://localhost:3000/api
VITE_API_URL=/api

# ---- docker-compose host port mapping ----
BACKEND_PORT=3000
FRONTEND_PORT=8080
