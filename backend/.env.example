# Copy to .env and fill in real values. Never commit .env — see .gitignore.

# PostgreSQL connection string. Local dev (Docker Postgres): see docker-compose.yml /
# root .env.example. Production (Render + Neon): paste the connection string from the
# Neon dashboard as-is — SSL and pooling are handled automatically by prisma.service.ts
# based on the hostname (see the comments there), no extra query params needed.
DATABASE_URL="postgresql://user:password@host:5432/dbname?schema=public"

# Random secret used to sign JWTs. Generate a strong one for production, e.g.:
#   openssl rand -hex 32
JWT_SECRET="change-me"
JWT_EXPIRES_IN="7d"

# Render sets PORT itself — this fallback only applies to local/non-Render runs.
PORT=3000

# Comma-separated list of exact origins allowed to call the API (CORS). Any
# https://*.vercel.app origin is always allowed in addition to this list, to cover
# Vercel preview deployments automatically — see backend/src/main.ts.
# Local dev: http://localhost:5173
# Production: https://your-project.vercel.app,https://afaaq.de,https://www.afaaq.de
FRONTEND_URL="http://localhost:5173"

LOG_LEVEL=log

# Groq API key for the chatbot and auto-translation (chat completions).
# Get one at https://console.groq.com/keys
GROQ_API_KEY="gsk_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
GROQ_MODEL="llama-3.3-70b-versatile"

# Stripe — one-time "frais de dossier" payment, required before an application can be
# submitted. Secret key (test or live): https://dashboard.stripe.com/test/apikeys
STRIPE_SECRET_KEY="REPLACE_WITH_YOUR_STRIPE_SECRET_KEY"
# Webhook signing secret — created when you add the endpoint at
# https://dashboard.stripe.com/test/webhooks (URL: <APP_URL>/api/payments/webhook).
# Local testing: `stripe listen --forward-to localhost:3000/api/payments/webhook` prints one.
STRIPE_WEBHOOK_SECRET="REPLACE_WITH_YOUR_STRIPE_WEBHOOK_SIGNING_SECRET"
# Fee amount in cents (2000 = 20,00 €).
STRIPE_APPLICATION_FEE_CENTS=2000

# Public frontend URL, used to build the Stripe Checkout success/cancel redirect.
# Local dev: http://localhost:5173. Production: https://afaaq.de (or the Vercel URL
# until the custom domain is wired up).
APP_URL="http://localhost:5173"
