# Copy this file to .env and fill in real values. Never commit .env.

DATABASE_URL="postgresql://postgres:secretpassword@127.0.0.1:5432/afaaq?schema=public"

JWT_SECRET="change-me"
JWT_EXPIRES_IN="7d"

PORT=3000
CORS_ORIGIN="http://localhost:5173"

# Groq API key for auto-translation (chat completions). Backend-only — never expose to the frontend.
# Get one at https://console.groq.com/keys
GROQ_API_KEY="gsk_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
GROQ_MODEL="llama-3.3-70b-versatile"
